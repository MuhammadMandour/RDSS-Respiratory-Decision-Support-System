# Copy to .env and replace every CHANGE_ME value. Never commit .env.
#   PowerShell: Copy-Item .env.example .env

# --- Database ---
POSTGRES_DB=rdss
POSTGRES_USER=rdss
POSTGRES_PASSWORD=CHANGE_ME_db_password

# --- Authentication ---
# At least 32 random characters. Generate in PowerShell:
#   -join ((1..48) | ForEach-Object { [char](Get-Random -Minimum 33 -Maximum 127) })
# (avoid the characters $ " ' and # which need escaping in .env)
JWT_SECRET=CHANGE_ME_at_least_32_random_characters_long
JWT_EXPIRATION=PT8H

# --- Orthanc (DICOM server, internal only) ---
ORTHANC_USERNAME=rdss
ORTHANC_PASSWORD=CHANGE_ME_orthanc_password
ORTHANC_DICOM_AET=RDSS

# --- Web ---
# Address/port the frontend is published on. Keep 127.0.0.1 unless behind a TLS reverse proxy.
RDSS_BIND_ADDRESS=127.0.0.1
RDSS_HTTP_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:8080

# --- First administrator ---
# Created on first start when no administrator exists. Remove the password after first login.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@rdss.local
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_admin_password

# --- Demo data ---
# true seeds synthetic demo users/patients on first start (never real patient data).
SEED_DEMO_DATA=false
# Password for seeded demo accounts. Required when SEED_DEMO_DATA=true in the prod profile.
DEMO_USER_PASSWORD=CHANGE_ME_demo_password

# --- HL7 v2 integration ---
# Shared key for POST /api/v1/hl7/messages (header X-Integration-Key). Empty disables the endpoint.
HL7_INBOUND_API_KEY=CHANGE_ME_long_random_integration_key
# MLLP listener (unauthenticated - enable only on a trusted network). The dev override enables it on 127.0.0.1:12575.
HL7_MLLP_ENABLED=false

# --- Decision support ---
# true shows a clearly labelled DEMONSTRATION inference placeholder (no model, no analysis).
CDSS_MOCK_INFERENCE=false

# --- Misc ---
API_DOCS_ENABLED=false
